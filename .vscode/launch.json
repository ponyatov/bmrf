{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "rust:linux",
            "cargo": {
                "args": [
                    "build",
                    "--target=x86_64-unknown-linux-gnu",
                    "--features=pc,linux"
                ]
            },
            "args": ["lib/${workspaceFolderBasename}.ini", "320", "240"],
            "cwd": "${workspaceFolder}"
        },
    ]
}
