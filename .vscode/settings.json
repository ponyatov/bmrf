{
        // files
    "files.exclude": {
        "doc/html/**": true,
    },
    "files.watcherExclude": {
        "ref/**": true, "target/**": true, "obj/**": true,
    },
    "files.associations": {
        "*.mk": "makefile",
        "*.ini": "flang", "*.f": "flang",
        "*.ocd": "properties", "*.gdb*": "properties",
        "*.ld": "linkerscript", "*.ld.fix": "linkerscript",
        "*.ioc": "properties", "*.config": "properties",
        "*.s": "arm", "*.s.fix": "arm", "*.S": "arm",
        "requirements.*": "properties",
        "memory.x": "linkerscript",
        "*.service": "systemd-unit-file"
    },

    // editor
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [80],
    "editor.lineNumbers": "on",
    "workbench.tree.indent": 24,
    "editor.fontSize": 14,
    "explorer.autoReveal": false,
    "git.enabled": false,
    "terminal.integrated.copyOnSelection": true,

    // terminal
    "SerialTerminal.serial port.configurations": ["115200n1","9600n1"],

    // JavaScript
    "prettier.configPath"         : ".prettierrc",
    "prettier.requireConfig"      :  true,
    "json.format.enable"          :  true,

    // clang-format
    "clang-format.executable"     : "clang-format",
    "clang-format.fallbackStyle"  : "Google",
    "clang-format.style"          : "file",

    // C++
    "[c]": {
        "editor.defaultFormatter" : "xaver.clang-format",
        "editor.formatOnSave"     :  false
    },
    "[cpp]": {
        "editor.defaultFormatter" : "xaver.clang-format",
        "editor.formatOnSave"     :  false
    },
    // "C_Cpp.intelliSenseEngine": "Tag Parser",
    // "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",

    // CMake
    "cmake.sourceDirectory" : "${workspaceFolder}",
    "cmake.buildDirectory"  : "${workspaceFolder}/tmp/${workspaceFolderBasename}",
    "cmake.generator"       : "Unix Makefiles",
    "cmake.parallelJobs"    :  2,
    "cmake.useCMakePresets" : "always",
    "cmake.ignoreCMakeListsMissing" : false,
    "cmake.buildBeforeRun"  :  true,
    "cmake.saveBeforeBuild" :  true,
    "cmake.debugConfig"     : {
        "cwd" :   "${workspaceFolder}",
        "args": [ "lib/${workspaceFolderBasename}.ini" ] },
    "cmake.allowCommentsInPresetsFile" : true,

    // Rust
    "rust-analyzer.checkOnSave"     : false,
    "rust-analyzer.check.allTargets": false,
    // "rust-analyzer.cargo.target"    : "x86_64-unknown-linux-gnu",
    // "rust-analyzer.cargo.features"  : ["linux"],
    // "rust-analyzer.cargo.target"    : "i686-unknown-uefi",
    // "rust-analyzer.cargo.features"  : ["uefi"],
    "rust-analyzer.cargo.target"    : ".config/i686-pc-bare.json",
    "rust-analyzer.cargo.features"  : ["i686","pc","bare"],
    // cortexM
    // "rust-analyzer.cargo.target"    : "thumbv7em-none-eabihf",
    // "rust-analyzer.cargo.features"  : ["netduinoplus2"],
    // "rust-analyzer.cargo.features"  : ["iskra"],
    // "rust-analyzer.cargo.features"  : ["f4disco"],
    // "rust-analyzer.cargo.features"  : ["f429disco"],
    // "rust-analyzer.cargo.target"    : "thumbv7m-none-eabi",
    // "rust-analyzer.cargo.features"  : ["pillF103"],
    // "rust-analyzer.cargo.target"    : "aarch64-unknown-linux-gnu",
    // "rust-analyzer.cargo.target"    : "wasm32-unknown-unknown",
    // "rust-analyzer.cargo.target"    : "i686-pc-windows-gnu",
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave"    :  false
        // "diffEditor.ignoreTrimWhitespace": false
    },

    // MinGW/MSYS2
    "terminal.integrated.defaultProfile.windows": "UCRT64",
    "terminal.integrated.profiles.windows": {
      "UCRT64": {
        "path": "C:\\msys64\\usr\\bin\\bash.exe",
        "args": ["--login","-i"],
        "env": {
          "MSYSTEM": "UCRT64",
          "CHERE_INVOKING": "1",
        }}},
}
